{
  "contract_version": "deepseek-openai-compatible-v2",
  "provider_code": ["DEEPSEEK", "DEEPSEEK_OPENAI_COMPATIBLE"],
  "transport": {
    "method": "POST",
    "path_suffix": "/chat/completions",
    "tls_required": true,
    "authentication": "bearer-from-env-or-file-secret-reference",
    "stream": false,
    "timeout_ms": 45000
  },
  "request": {
    "required_fields": ["model", "messages", "response_format", "max_tokens", "stream"],
    "response_format": {"type": "json_object"},
    "allowed_roles": ["system", "user"]
  },
  "response": {
    "content_path": "choices[0].message.content",
    "content_schema": {
      "type": "object",
      "required": ["summary", "facts", "gaps", "warnings"],
      "additionalProperties": false,
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "facts": {"type": "array", "maxItems": 24, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "gaps": {"type": "array", "maxItems": 24, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "warnings": {"type": "array", "maxItems": 24, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
      }
    }
  },
  "safety": {
    "clinical_write_authority": false,
    "human_review_required": true,
    "post_generation_guard": "AgentOutputGuard",
    "provider_failure_state": "DEGRADED",
    "log_request_or_secret": false
  }
}
