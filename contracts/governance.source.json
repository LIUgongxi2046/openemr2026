{
  "schema_version": 1,
  "status": "CREATED",
  "defaults": {
    "auth": "OIDC_SESSION + ContextLease + domain authorization",
    "read_timeout_ms": 3000,
    "write_timeout_ms": 8000,
    "rate_limit": "policy:<operation_id>",
    "write_idempotency": "Idempotency-Key + domain unique constraints + expected version",
    "read_idempotency": "SAFE_READ"
  },
  "operation_overrides": {
    "createContextLease": {"caller":"WEB_BFF","auth":"OIDC session + organization/facility/role/purpose policy","timeout_ms":3000,"idempotency":"Idempotency-Key + authorization watermark","error_refs":["AUTHENTICATION_REQUIRED","SCOPE_DENIED"],"status":"EXPLICIT_S005"},
    "saveDocumentDraft": {"caller":"WEB_BFF","auth":"ContextLease + document.edit + patient/encounter match","timeout_ms":3000,"idempotency":"Idempotency-Key + If-Match","error_refs":["VERSION_CONFLICT","PATIENT_CONTEXT_CHANGED","RULE_BLOCKED"],"status":"EXPLICIT_S005"},
    "runDocumentQualityChecks": {"caller":"WEB_BFF_OR_JOB","auth":"ContextLease + quality.check","timeout_ms":8000,"idempotency":"document version + content hash + rule release","error_refs":["PATIENT_CONTEXT_CHANGED","RULE_BLOCKED"],"status":"EXPLICIT_S005"},
    "signDocument": {"caller":"WEB_BFF","auth":"ContextLease + document.sign + active credential","timeout_ms":8000,"idempotency":"Idempotency-Key + expected document version","error_refs":["QUALITY_CHECK_REQUIRED","SIGNING_RULE_BLOCKED","DEPENDENCY_TIMEOUT"],"status":"EXPLICIT_S005"},
    "createClinicalOrder": {"caller":"WEB_BFF","auth":"ContextLease + order.create + qualification","timeout_ms":8000,"idempotency":"Idempotency-Key + encounter/order business key","error_refs":["PATIENT_CONTEXT_CHANGED","RULE_BLOCKED","VERSION_CONFLICT"],"status":"EXPLICIT_S005"},
    "recordOrderExecutionEvent": {"caller":"WEB_BFF_OR_DEVICE_GATEWAY","auth":"ContextLease + execution role + one-time verification token","timeout_ms":8000,"idempotency":"execution token + event business key","error_refs":["PATIENT_CONTEXT_CHANGED","RULE_BLOCKED","IDEMPOTENCY_IN_PROGRESS"],"status":"EXPLICIT_S005"},
    "putDepartmentSupportAssessment": {"caller":"GOVERNANCE_CONSOLE","auth":"specialty governance + separation of duties","timeout_ms":8000,"idempotency":"If-Match + evidence bundle hash","error_refs":["SCOPE_DENIED","VERSION_CONFLICT","RULE_BLOCKED"],"status":"EXPLICIT_S005"},
    "createArchiveExportPackage": {"caller":"MEDICAL_RECORDS_CONSOLE","auth":"ContextLease + sealed archive + purpose + role","timeout_ms":2000,"idempotency":"Idempotency-Key + archive manifest + purpose","error_refs":["SCOPE_DENIED","RULE_BLOCKED","INTERNAL_INTEGRITY_FAILURE"],"status":"EXPLICIT_S005"},
    "createAiRun": {"caller":"WEB_BFF","auth":"ContextLease + enabled use case + model residency policy","timeout_ms":2000,"idempotency":"Idempotency-Key + context lease + use case","error_refs":["LEASE_EXPIRED","SCOPE_DENIED","RATE_LIMITED"],"status":"EXPLICIT_S005"},
    "decideAiProposal": {"caller":"WEB_BFF","auth":"ContextLease + proposal reviewer + expected proposal version","timeout_ms":3000,"idempotency":"Idempotency-Key + proposal decision","error_refs":["LEASE_EXPIRED","PATIENT_CONTEXT_CHANGED","VERSION_CONFLICT"],"status":"EXPLICIT_S005"}
  },
  "errors": [
    {"code":"API_ERROR","http_status":500,"retryable":false,"user_message":"操作未完成，请使用追踪号联系管理员。","log_level":"ERROR","recovery":"CONTACT_ADMIN"},
    {"code":"AUTHENTICATION_REQUIRED","http_status":401,"retryable":false,"user_message":"会话已失效，请重新登录。","log_level":"INFO","recovery":"REAUTHENTICATE"},
    {"code":"RESOURCE_NOT_FOUND_OR_DENIED","http_status":404,"retryable":false,"user_message":"无权访问或资源不存在。","log_level":"WARN","recovery":"RETURN_TO_QUEUE"},
    {"code":"SCOPE_DENIED","http_status":403,"retryable":false,"user_message":"当前上下文无权执行该操作。","log_level":"WARN","recovery":"REQUEST_ACCESS"},
    {"code":"PATIENT_CONTEXT_CHANGED","http_status":409,"retryable":false,"user_message":"患者或就诊上下文已变化，旧操作未提交。","log_level":"WARN","recovery":"RETURN_TO_QUEUE"},
    {"code":"VERSION_CONFLICT","http_status":409,"retryable":false,"user_message":"资源已被更新，不能静默覆盖。","log_level":"INFO","recovery":"OPEN_DIFF"},
    {"code":"RULE_BLOCKED","http_status":422,"retryable":false,"user_message":"存在必须处理的安全项。","log_level":"INFO","recovery":"LOCATE_VIOLATION"},
    {"code":"IDEMPOTENCY_IN_PROGRESS","http_status":409,"retryable":true,"user_message":"操作仍在处理中。","log_level":"INFO","recovery":"QUERY_FINAL_STATE"},
    {"code":"DEPENDENCY_TIMEOUT","http_status":503,"retryable":true,"user_message":"外部服务暂不可用。","log_level":"WARN","recovery":"RECONCILE_OR_RETRY"},
    {"code":"PARTIAL_SOURCE","http_status":206,"retryable":false,"user_message":"部分来源不可用，当前数据不完整。","log_level":"INFO","recovery":"RETRY_MISSING_SOURCE"},
    {"code":"RATE_LIMITED","http_status":429,"retryable":true,"user_message":"请求过于频繁。","log_level":"INFO","recovery":"HONOR_RETRY_AFTER"},
    {"code":"INTERNAL_INTEGRITY_FAILURE","http_status":500,"retryable":false,"user_message":"完整性校验失败，操作未完成。","log_level":"ERROR","recovery":"BLOCK_AND_RECONCILE"},
    {"code":"QUALITY_CHECK_REQUIRED","http_status":422,"retryable":false,"user_message":"当前文书版本需先完成质控。","log_level":"INFO","recovery":"RUN_QUALITY_CHECK"},
    {"code":"SIGNING_RULE_BLOCKED","http_status":422,"retryable":false,"user_message":"当前版本不满足签署条件。","log_level":"INFO","recovery":"LOCATE_VIOLATION"},
    {"code":"LEASE_EXPIRED","http_status":409,"retryable":false,"user_message":"当前上下文已过期。","log_level":"INFO","recovery":"RENEW_CONTEXT"},
    {"code":"SCHEMA_UNSUPPORTED","http_status":422,"retryable":false,"user_message":"当前数据版本不受支持。","log_level":"WARN","recovery":"REFRESH_CLIENT"}
  ],
  "events": [
    {"event_id":"ai.run.event.v1","topic":"ai.run.event","producer":"ai-runtime","consumers":["web-bff","audit","operations"],"schema_ref":"AIRunEvent","ordering":"run_id + sequence","idempotency":"event_id","retention":"24h configurable","status":"CREATED"},
    {"event_id":"clinical.fact.changed.v1","topic":"clinical.fact.changed.v1","producer":"clinical modules via outbox","consumers":["search","quality","data-center"],"schema_ref":"OutboxEvent","ordering":"aggregate_id + aggregate_version","idempotency":"consumer_name + event_id","retention":"deployment policy","status":"CREATED"}
  ],
  "agents": [
    {"agent_id":"document-drafter@1","goal":"生成有来源的门急住文书候选","non_goals":["自动诊断","直接写库","签署"],"input_schema":"DocumentDraftInputV1","output_schema":"DocumentDraftProposalV1","allowed_tools":["get_current_document_version@1","list_recent_observations@1","create_document_proposal@1"],"data_scope":"ContextLease encounter only","budget":{"max_wall_time_seconds":45,"max_model_calls":4,"max_tool_calls":12,"max_retries":2},"termination":"schema/source/policy/budget failure","escalation":"responsible clinician manual template","owner":"medical-records + ai-governance","status":"CREATED"},
    {"agent_id":"record-qc@1","goal":"为硬规则提供语义遗漏与一致性第二视角","non_goals":["改变硬规则严重度","触发签署"],"input_schema":"RecordQCInputV1","output_schema":"RecordQCProposalV1","allowed_tools":["get_current_document_version@1","create_document_proposal@1"],"data_scope":"immutable current document version","budget":{"max_wall_time_seconds":45,"max_model_calls":4,"max_tool_calls":8,"max_retries":2},"termination":"wrong-patient or unaddressable source","escalation":"quality clinician","owner":"quality-office + ai-governance","status":"CREATED"},
    {"agent_id":"encounter-summarizer@1","goal":"生成当次就诊有引用摘要","non_goals":["填补缺失事实","跨就诊扩权"],"input_schema":"EncounterSummaryInputV1","output_schema":"CitedSummaryV1","allowed_tools":["list_recent_observations@1","get_current_document_version@1"],"data_scope":"ContextLease time range","budget":{"max_wall_time_seconds":30,"max_model_calls":3,"max_tool_calls":8,"max_retries":1},"termination":"policy/source/budget failure","escalation":"show source gaps and return manual","owner":"clinical-app","status":"CREATED"},
    {"agent_id":"verification-agent@1","goal":"独立验证候选结构、来源和安全","non_goals":["修改候选","业务写入"],"input_schema":"VerificationInputV1","output_schema":"VerificationReportV1","allowed_tools":["get_current_document_version@1","list_recent_observations@1"],"data_scope":"original proposal references only","budget":{"max_wall_time_seconds":20,"max_model_calls":2,"max_tool_calls":4,"max_retries":1},"termination":"high-risk uncertainty","escalation":"clinical human review","owner":"independent-eval","status":"CREATED"}
  ],
  "tools": [
    {"tool_id":"get_current_document_version@1","purpose":"读当前不可变文书版本","input_schema":"DocumentRefInputV1","output_schema":"DocumentVersionRefV1","permission":"document.read","side_effect":"NONE","idempotency":"SAFE_READ","timeout_ms":3000,"error_codes":["LEASE_EXPIRED","RESOURCE_NOT_FOUND_OR_DENIED","PARTIAL_SOURCE"],"audit":"run/lease/resource/hash","approval":"ALLOW"},
    {"tool_id":"list_recent_observations@1","purpose":"按编码和时间返回结果引用","input_schema":"ObservationQueryV1","output_schema":"ObservationReferencesV1","permission":"observation.read","side_effect":"NONE","idempotency":"SAFE_READ","timeout_ms":3000,"error_codes":["LEASE_EXPIRED","PARTIAL_SOURCE"],"audit":"run/lease/code-count/time-range","approval":"ALLOW"},
    {"tool_id":"calculate_pediatric_dose_range@1","purpose":"执行版本化确定性儿科范围计算","input_schema":"PediatricDoseInputV1","output_schema":"PediatricDoseRangeV1","permission":"clinical.calculate","side_effect":"NONE","idempotency":"normalized arguments hash","timeout_ms":1000,"error_codes":["RULE_BLOCKED","SCHEMA_UNSUPPORTED"],"audit":"rule-version/input-summary/result-hash","approval":"ALLOW"},
    {"tool_id":"create_document_proposal@1","purpose":"保存独立 AI 候选","input_schema":"DocumentDraftProposalV1","output_schema":"ProposalRefV1","permission":"ai.proposal.create","side_effect":"CANDIDATE_ONLY","idempotency":"run + proposal type + payload hash","timeout_ms":3000,"error_codes":["SCHEMA_UNSUPPORTED","PATIENT_CONTEXT_CHANGED"],"audit":"proposal/hash/releases","approval":"ALLOW"},
    {"tool_id":"propose_order_items@1","purpose":"生成医嘱业务命令预览，不执行","input_schema":"OrderItemsProposalV1","output_schema":"ProposalRefV1","permission":"order.propose","side_effect":"POTENTIAL_CLINICAL_SIDE_EFFECT","idempotency":"proposal id","timeout_ms":3000,"error_codes":["RULE_BLOCKED","SCOPE_DENIED"],"audit":"object/diff/consequence","approval":"ASK_EACH_TIME"}
  ]
}
