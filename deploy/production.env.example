# openemr2026 production configuration contract.
# This file contains references only. Never commit the target secret values.

SPRING_PROFILES_ACTIVE=prod
OPENEMR2026_DEPLOYMENT_ID=hospital-a-prod
OPENEMR2026_DATA_RESIDENCY=ON_PREM_ONLY

OPENEMR2026_DB_URL=jdbc:postgresql://database.internal:5432/openemr2026
OPENEMR2026_DB_USER=openemr2026_app
OPENEMR2026_DB_PASSWORD_REF=env://OPENEMR2026_DB_PASSWORD

OPENEMR2026_OIDC_ISSUER_URI=https://idp.hospital.example/oidc
OPENEMR2026_OIDC_AUDIENCE=openemr2026-clinical
OPENEMR2026_OIDC_REQUIRED_ACR=urn:openemr2026:acr:mfa
OPENEMR2026_OIDC_MFA_REQUIRED=true

OPENEMR2026_CA_BASE_URI=https://ca.hospital.example/api
OPENEMR2026_TIMESTAMP_URI=https://tsa.hospital.example/api
OPENEMR2026_CA_CLIENT_CERTIFICATE_REF=file:///run/secrets/openemr2026_ca_client_certificate
OPENEMR2026_CA_PRIVATE_KEY_REF=file:///run/secrets/openemr2026_ca_private_key
OPENEMR2026_CA_TRUST_ANCHOR_REF=file:///run/secrets/openemr2026_ca_trust_anchor

OPENEMR2026_KMS_KEY_URI=kms://hospital-kms/openemr2026-master
OPENEMR2026_DATABASE_ENCRYPTION_KEY_REF=file:///run/secrets/openemr2026_database_encryption_key
OPENEMR2026_OBJECT_ENCRYPTION_KEY_REF=file:///run/secrets/openemr2026_object_encryption_key

OPENEMR2026_OBJECT_STORAGE_ENDPOINT=https://objects.hospital.example
OPENEMR2026_OBJECT_STORAGE_BUCKET=openemr2026-records
OPENEMR2026_OBJECT_STORAGE_ACCESS_KEY_REF=file:///run/secrets/openemr2026_object_storage_access_key
OPENEMR2026_OBJECT_STORAGE_SECRET_KEY_REF=file:///run/secrets/openemr2026_object_storage_secret_key
OPENEMR2026_OBJECT_STORAGE_LOCK_REQUIRED=true

OPENEMR2026_INTEGRATION_TRUSTSTORE_REF=file:///run/secrets/openemr2026_integration_truststore
OPENEMR2026_INTEGRATION_CLIENT_CERTIFICATE_REF=file:///run/secrets/openemr2026_integration_client_certificate

# AI remains disabled until A01 and the model harness gates are verified.
OPENEMR2026_AI_ENABLED=false
OPENEMR2026_AI_BASE_URI=
OPENEMR2026_AI_MODEL_ID=
OPENEMR2026_AI_API_KEY_REF=
OPENEMR2026_AI_RESIDENCY=ON_PREM_ONLY
